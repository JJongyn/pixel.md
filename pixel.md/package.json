{
  "name": "pixel.md",
  "version": "0.1.3",
  "description": "Small pixel UI components for AI and agent interfaces",
  "type": "module",
  "license": "MIT",
  "author": "JJongyn",
  "homepage": "https://jjongyn.github.io/pixel.md/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJongyn/pixel.md.git",
    "directory": "pixel.md"
  },
  "bugs": {
    "url": "https://github.com/JJongyn/pixel.md/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "files": [
    "src",
    "types",
    "skills",
    "examples",
    "README.md",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./indicator": {
      "types": "./types/indicator.d.ts",
      "default": "./src/pixel-agent-status.js"
    },
    "./chat-effect": {
      "types": "./types/chat-effect.d.ts",
      "default": "./src/pixel-chat-effect.js"
    },
    "./elements": {
      "types": "./types/elements.d.ts",
      "default": "./src/pixel-ui-element.js"
    },
    "./bot": {
      "types": "./types/bot.d.ts",
      "default": "./src/pixel-bot-avatar.js"
    },
    "./terminal": {
      "types": "./types/terminal.d.ts",
      "default": "./src/pixel-cli.js"
    },
    "./cli": {
      "types": "./types/terminal.d.ts",
      "default": "./src/pixel-cli.js"
    },
    "./terminal-preview": {
      "types": "./types/terminal-preview.d.ts",
      "default": "./src/pixel-terminal.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "keywords": [
    "web-components",
    "pixel",
    "agent",
    "bot",
    "avatar",
    "ai",
    "chat",
    "ui",
    "animation",
    "terminal",
    "cli",
    "shell"
  ],
  "scripts": {
    "prepack": "node scripts/sync-skills.mjs"
  }
}
